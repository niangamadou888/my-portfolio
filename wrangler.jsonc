{
  // Cloudflare Workers Builds runs `npx wrangler deploy` after `astro build`.
  // Built files in `dist` are served directly; only requests with no matching
  // file (today just POST /api/contact) reach the Worker in worker/index.ts.
  "name": "my-portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Page navigations to unknown paths get dist/404.html with a real 404 status. Other unmatched requests (e.g. POST /api/contact) reach the Worker in worker/index.ts.
    "not_found_handling": "404-page"
  },
  // Per-IP limit on the contact form. Cloudflare only allows 10 or 60 s periods.
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "48101",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // Keeps console.error output from the contact handler in Workers Logs.
  "observability": {
    "enabled": true
  }
  // RESEND_API_KEY is a secret: set it in the dashboard (Settings → Variables
  // and Secrets) or with `npx wrangler secret put RESEND_API_KEY`.
}
