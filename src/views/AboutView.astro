---
import { Award, Briefcase, Calendar, CheckCircle, ExternalLink, FileDown, GraduationCap, MapPin } from "lucide-react";
import SectionHeading from "@/components/SectionHeading.astro";
import { CERTIFICATIONS } from "@/data/certifications";
import { EDUCATION } from "@/data/education";
import { EXPERIENCE } from "@/data/experience";
import { TECH_STACK } from "@/data/tech-stack";
import type { Lang } from "@/i18n/ui";
import { t } from "@/i18n/utils";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { CV_PATHS } from "@/lib/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const cvLinks = [
  { href: encodeURI(CV_PATHS.en), label: t(lang, "about.cvEn") },
  { href: encodeURI(CV_PATHS.fr), label: t(lang, "about.cvFr") },
];
const pill = "inline-flex items-center gap-2 text-sm font-medium px-3 py-1.5 rounded-full self-start flex-shrink-0 text-[#d6c9b6] bg-[rgba(214,201,182,0.1)] border border-[rgba(214,201,182,0.25)]";
---
<BaseLayout lang={lang} path="/about/" title={t(lang, "about.metaTitle")} description={t(lang, "about.description")}>
  <section class="section-container pt-32">
    <div class="orb orb-purple" style="width:500px;height:500px;top:-5%;left:-10%"></div>
    <div class="section-inner">
      <SectionHeading as="h1" eyebrow={t(lang, "nav.about")} title={t(lang, "about.title")} />
      <div class="grid md:grid-cols-2 gap-8">
        <div class="reveal glass-card glow-border rounded-2xl p-8 space-y-5">
          <p class="leading-relaxed text-white/80">{t(lang, "about.p1")}</p>
          <p class="leading-relaxed text-white/80">{t(lang, "about.p2")}</p>
          <p class="leading-relaxed text-white/80">{t(lang, "about.p3")}</p>
          <div class="flex flex-wrap gap-3 pt-2">
            {cvLinks.map((cv) => (
              <a
                href={cv.href}
                download
                class="btn-glow inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-semibold text-white"
                style="background:rgba(214,201,182,0.12);border:1px solid rgba(214,201,182,0.3)"
              >
                <FileDown className="w-4 h-4" aria-hidden="true" />
                {cv.label}
              </a>
            ))}
          </div>
        </div>
        <div class="reveal glass-card glow-border rounded-2xl p-8">
          <h2 class="eyebrow mb-6">{t(lang, "about.skills")}</h2>
          <ul class="flex flex-wrap gap-3">
            {TECH_STACK.map((tech) => (
              <li class="flex items-center gap-2 px-3 py-2 bg-secondary/50 rounded-full text-sm">
                <img src={tech.icon} alt="" width="20" height="20" loading="lazy" decoding="async" class="w-5 h-5" />
                <span class="text-white/80">{tech.name}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="experience" class="section-container">
    <span class="section-num" aria-hidden="true">01</span>
    <div class="section-inner">
      <SectionHeading eyebrow={t(lang, "about.experience")} title={t(lang, "about.experience")} tone="pink" />
      <div class="relative pl-8 md:pl-12">
        <div class="timeline-line hidden md:block"></div>
        <div class="space-y-8">
          {EXPERIENCE.map((item) => (
            <article class="reveal relative">
              <div class="timeline-dot hidden md:block"></div>
              <div class="glass-card glow-border rounded-2xl p-6 md:p-8">
                <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                  <div class="space-y-2">
                    <div class="flex items-center gap-3">
                      <Briefcase className="h-4 w-4 flex-shrink-0 text-[#d6c9b6]" aria-hidden="true" />
                      <h3 class="font-semibold text-lg text-white/90">{item.title[lang]}</h3>
                    </div>
                    <div class="pl-7 space-y-1.5">
                      <p class="font-medium text-sm text-[#d6c9b6]">{item.company[lang]}</p>
                      <p class="flex items-center gap-2 text-sm text-white/65">
                        <MapPin className="h-3.5 w-3.5" aria-hidden="true" />
                        {item.location[lang]}
                      </p>
                    </div>
                  </div>
                  <span class={pill}>
                    <Calendar className="h-3.5 w-3.5" aria-hidden="true" />
                    {item.period[lang]}
                  </span>
                </div>
                <p class="mt-4 text-sm leading-relaxed pl-7 text-white/70">{item.description[lang]}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="education" class="section-container">
    <span class="section-num" aria-hidden="true">02</span>
    <div class="orb orb-cyan" style="width:450px;height:450px;top:0%;left:-12%"></div>
    <div class="section-inner">
      <SectionHeading eyebrow={t(lang, "about.education")} title={t(lang, "about.education")} />
      <div class="space-y-8">
        {EDUCATION.map((item) => (
          <article class="reveal glass-card glow-border rounded-2xl p-6 md:p-8 relative overflow-hidden">
            <div class="absolute top-0 inset-x-0 h-0.5" style="background: linear-gradient(90deg, #d6c9b660, transparent)"></div>
            <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-4">
              <div class="space-y-2">
                <div class="flex items-start gap-3">
                  <GraduationCap className="h-5 w-5 mt-0.5 flex-shrink-0 text-[#d6c9b6]" aria-hidden="true" />
                  <h3 class="font-semibold text-lg leading-snug text-white/90">{item.degree[lang]}</h3>
                </div>
                <div class="pl-8 space-y-1.5">
                  <p class="font-medium text-sm text-[#d6c9b6]">{item.school}</p>
                  <p class="flex items-center gap-2 text-sm text-white/65">
                    <MapPin className="h-3.5 w-3.5" aria-hidden="true" />
                    {item.location[lang]}
                  </p>
                </div>
              </div>
              <span class={pill}>
                <Calendar className="h-3.5 w-3.5" aria-hidden="true" />
                {item.period[lang]}
              </span>
            </div>
            <p class="text-sm leading-relaxed pl-8 mb-5 text-white/70">{item.description[lang]}</p>
            <ul class="space-y-2 pl-8">
              {item.achievements.map((achievement) => (
                <li class="flex items-start gap-2.5 text-sm text-white/70">
                  <CheckCircle className="h-4 w-4 mt-0.5 flex-shrink-0 text-[#d6c9b6]" aria-hidden="true" />
                  {achievement[lang]}
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="certifications" class="section-container">
    <span class="section-num" aria-hidden="true">03</span>
    <div class="section-inner">
      <SectionHeading eyebrow={t(lang, "about.certifications")} title={t(lang, "about.certifications")} />
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {CERTIFICATIONS.map((cert) => (
          <article class="reveal glass-card rounded-2xl p-6 h-full flex flex-col relative overflow-hidden">
            <div class="flex items-start justify-between mb-3">
              <Award className="h-5 w-5 flex-shrink-0 mt-0.5 text-[#d6c9b6]" aria-hidden="true" />
              <span class="flex items-center gap-1.5 text-xs font-medium px-2.5 py-1 rounded-full text-[#d6c9b6] border border-[rgba(214,201,182,0.25)]">
                <Calendar className="h-3 w-3" aria-hidden="true" />
                {cert.date}
              </span>
            </div>
            <h3 class="font-semibold text-base leading-snug mb-1 text-white/90">{cert.title[lang]}</h3>
            <p class="text-sm font-medium mb-4 text-[#d6c9b6]">{cert.issuer}</p>
            <p class="text-xs leading-relaxed flex-1 text-white/65">{cert.skills.join(" · ")}</p>
            {cert.link && (
              <a
                href={cert.link}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-5 pt-4 flex items-center justify-between text-xs font-medium text-[#d6c9b6] hover:text-white border-t border-[rgba(214,201,182,0.15)]"
              >
                {t(lang, "about.viewCert")}
                <ExternalLink className="h-3.5 w-3.5" aria-hidden="true" />
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
