---
import type { Lang } from "@/i18n/ui";
import { localizePath, t } from "@/i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---
<section class="section-container">
  <div class="orb orb-pink" style="width:400px;height:400px;bottom:-10%;right:-10%"></div>
  <div class="section-inner" style="max-width:56rem">
    <div class="reveal glass-card glow-border rounded-3xl p-10 md:p-14 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold gradient-text-pink mb-4">{t(lang, "cta.title")}</h2>
      <p class="text-base text-white/75 max-w-xl mx-auto mb-8">{t(lang, "cta.text")}</p>
      <a
        href={localizePath("/contact/", lang)}
        class="btn-glow inline-flex items-center gap-2 px-8 py-3.5 rounded-full text-sm font-semibold text-white"
        style="background:rgba(214,201,182,0.15);border:1px solid rgba(214,201,182,0.3)"
      >
        {t(lang, "cta.button")}
      </a>
    </div>
  </div>
</section>
