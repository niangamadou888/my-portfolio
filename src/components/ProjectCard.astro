---
import { Image } from "astro:assets";
import { ExternalLink, Github } from "lucide-react";
import TechTag from "@/components/TechTag";
import type { MoreProject } from "@/data/more-projects";
import type { Lang } from "@/i18n/ui";
import { t } from "@/i18n/utils";

interface Props {
  project: MoreProject;
  lang: Lang;
}

const { project, lang } = Astro.props;
---
<article class="reveal glass-card rounded-2xl overflow-hidden flex flex-col">
  <Image
    src={project.image}
    alt=""
    widths={[400, 800]}
    sizes="(min-width: 1024px) 384px, (min-width: 640px) 50vw, 100vw"
    class="aspect-video object-cover w-full"
  />
  <div class="p-6 space-y-3 flex-1 flex flex-col">
    <h3 class="font-semibold text-base text-white/90">{project.title}</h3>
    <p class="text-sm leading-relaxed text-white/70 flex-1">{project.description[lang]}</p>
    <ul class="flex flex-wrap gap-1.5 pt-1">
      {project.tags.map((tag) => <li><TechTag name={tag} /></li>)}
    </ul>
    {(project.liveUrl || project.githubUrl) && (
      <div class="flex gap-5 pt-2 text-sm">
        {project.liveUrl && (
          <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-[#d6c9b6] hover:text-white">
            <ExternalLink className="w-4 h-4" aria-hidden="true" />
            {t(lang, "work.live")}<span class="sr-only">: {project.title}</span>
          </a>
        )}
        {project.githubUrl && (
          <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-[#d6c9b6] hover:text-white">
            <Github className="w-4 h-4" aria-hidden="true" />
            {t(lang, "work.code")}<span class="sr-only">: {project.title}</span>
          </a>
        )}
      </div>
    )}
  </div>
</article>
