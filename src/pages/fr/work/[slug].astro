---
import type { GetStaticPaths } from "astro";
import { workPaths, type WorkEntry } from "@/lib/collections";
import CaseStudyView from "@/views/CaseStudyView.astro";

export const getStaticPaths = (() => workPaths("fr")) satisfies GetStaticPaths;

interface Props {
  entry: WorkEntry;
}

const { entry } = Astro.props;
---
<CaseStudyView lang="fr" entry={entry} />
