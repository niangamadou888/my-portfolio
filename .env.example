# Copy to .dev.vars for local testing of the contact Worker (`npm run preview:worker`).
# In production RESEND_API_KEY is a Cloudflare secret: Workers & Pages → my-portfolio →
# Settings → Variables and Secrets (or `npx wrangler secret put RESEND_API_KEY`).
# .dev.vars and .env are gitignored — never commit real keys.

# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: where contact form submissions are delivered (defaults to this address).
CONTACT_TO_EMAIL=amadouniang2001@gmail.com

# Optional sender address. The domain must be verified at https://resend.com/domains,
# otherwise Resend rejects the send with a 403.
CONTACT_FROM_EMAIL="Portfolio <contact@amadouniang.dev>"
